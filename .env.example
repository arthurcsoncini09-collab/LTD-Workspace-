# Copie este arquivo para .env.local e preencha.
# Sem DATABASE_URL o site funciona normalmente, mas o progresso fica só no navegador (sem login).
#
# Na Vercel, a integração Neon cria esta variável sozinha.
# No painel da Neon: Dashboard > Connect > copie a "connection string" (com ?sslmode=require).
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-123456.sa-east-1.aws.neon.tech/neondb?sslmode=require"
